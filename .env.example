# ---------- pipeline (CLI + webapp) ----------
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=
RECALL_API_KEY=
# Region Recall.ai: us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=eu-central-1
# Równoległość mini-ASR (tiebreak + odzysk overlapów)
ELEVENLABS_STT_CONCURRENCY=8

# ---------- webapp ----------
BASE_URL=http://localhost:8000
# openssl rand -hex 32
SECRET_KEY=

# Google OAuth (Cloud Console → APIs & Services → Credentials → OAuth client ID,
# typ "Web application"). Redirect URI: <BASE_URL>/auth/callback
# Włącz też Google Calendar API w tym samym projekcie.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Puste = każde konto Google. Lista po przecinku = tylko te domeny.
ALLOWED_GOOGLE_DOMAINS=example.com
# Tylko lokalny dev: pomija logowanie (NIE ustawiać na deployu).
AUTH_DISABLED=

# Baza. Puste = SQLite w output/webapp.db. Postgres: postgresql+psycopg://...
DATABASE_URL=
# Gdzie lądują assety Recall i transkrypty (domyślnie output/recall, output/webapp)
RECALL_DIR=
TRANSCRIPTS_DIR=

# ---------- worker ----------
WORKER_CONCURRENCY=2
# Sync z Recall co N sekund (0 = tylko ręcznie)
AUTOSYNC_INTERVAL=300
# Po syncu automatycznie kolejkuj fetch + transkrypcję gotowych nagrań.
# UWAGA: to wydaje pieniądze w ElevenLabs bez pytania.
AUTOPROCESS=
SYNC_LOOKBACK_DAYS=30
# Job bez heartbeatu dłużej niż tyle sekund wraca do kolejki
JOB_STALE_AFTER=900
